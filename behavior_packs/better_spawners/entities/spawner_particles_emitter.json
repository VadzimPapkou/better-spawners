{
    "format_version": "1.26.20",
    "minecraft:entity": {
        "description": {
            "identifier": "better_spawners:spawner_particles_emitter",
            "is_spawnable": false,
            "is_summonable": true,
            "is_experimental": false
        },
        "components": {
            "minecraft:type_family": {
                "family": ["inanimate", "spawner_fx"]
            },
            "minecraft:collision_box": {
                "width": 0.01,
                "height": 0.01
            },
            "minecraft:entity_sensor": {
                "find_players_only": true,
                "subsensors": [
                    {
                        "range": [16, 16],
                        "minimum_count": 1,
                        "event": "better_spawners:has_player_in_range"
                    },
                    {
                        "range": [16, 16],
                        "minimum_count": 0,
                        "maximum_count": 0,
                        "event": "better_spawners:no_player_in_range"
                    }
                ]
            },
            "minecraft:health": {
                "value": 1,
                "max": 1
            },
            "minecraft:damage_sensor": {
                "triggers": {
                    "cause": "all",
                    "deals_damage": "no"
                }
            },
            "minecraft:physics": {
                "has_collision": false,
                "has_gravity": false
            },
            "minecraft:knockback_resistance": {
                "value": 1
            },
            "minecraft:persistent": {}
        },
        "component_groups": {
            "better_spawners:active": {
                "minecraft:mark_variant": {
                    "value": 1
                }
            },
            "better_spawners:inactive": {
                "minecraft:mark_variant": {
                    "value": 0
                }
            }
        },
        "events": {
            "better_spawners:has_player_in_range": {
                "add": { "component_groups": ["better_spawners:active"] },
                "remove": { "component_groups": ["better_spawners:inactive"] }
            },
            "better_spawners:no_player_in_range": {
                "add": { "component_groups": ["better_spawners:inactive"] },
                "remove": { "component_groups": ["better_spawners:active"] }
            }
        }
    }
}
